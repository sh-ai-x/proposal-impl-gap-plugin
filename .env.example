# Copy to .env (gitignored) and fill in whichever provider(s) you use.
# gap_plugin loads .env automatically via python-dotenv.

ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=

# For --judge jev (TypeSafe System One / Jev). Escalates to an LLM judge
# (ANTHROPIC_API_KEY or the chosen --provider) when Jev itself is unsure.
TYPESAFE_API_KEY=
