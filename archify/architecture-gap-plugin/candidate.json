  "cards": [
    { "dot": "cyan", "title": "Top-level (linear)", "items": ["for doc in docs: for section: retrieval_graph.run → verdict", "Top-level stays a for-loop — no LangGraph overhead at the orchestrator level", "Repo-wide, one pass: every discovered doc scanned in the same scan() call"] },
    { "dot": "emerald", "title": "Retrieval (state machine)", "items": ["LangGraph handles retry-with-judge + bounded retry budget", "BM25 → judge (option) → accept / rewrite → re-query / missing_info"] },
    { "dot": "violet", "title": "Judge candidates", "items": ["Jev — typed judgment + probability (TypeSafe System One), calibrated confidence, fast", "claude-haiku with structured output — strong general reasoning, ~$0.001/call, vendor-flexible", "Heuristic (no AI, baseline) — token overlap + After-intersect, free but recall-limited", "Pick via A/B eval on GT; diagrams show both options, decision deferred until data lands"] },
    { "dot": "amber", "title": "Cost model", "items": ["~$0.58 per 50-section proposal (haiku judge + sonnet verdict, Jev roughly comparable)", "BM25 + symbol index: free, build-once", "LangSmith trace: free tier covers PR-time gate"] },
    { "dot": "rose", "title": "Failure-first design", "items": ["missing_info is a first-class per-section outcome (no silent miss)", "Judge confidence threshold 0.7 gates acceptance (works for all three candidates)", "Synonym/CamelCase rewrite handles paraphrase without embeddings"] },
    { "dot": "slate", "title": "Human Review (new)", "items": ["Separate consumer, not inside scan() — reads the same emit_report JSON/MD, never called by pipeline.py", "CI path stays synchronous-human-free: exit code / fail check only, exactly as before", "Interactive session: AskUserQuestion with dual-cited evidence per disputed claim, pipeline never auto-decides who's right", "decisions.jsonl is the only new state gap_plugin owns — append-only, one line per resolved claim_id", "Doc-level rot check (>80% missing+contradicted) triggers git rm + explanation, not a per-claim heuristic"] }
  ]
